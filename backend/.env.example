# AgentFlow AI - Environment Configuration

# Gemini API Key (Required for real LLM reasoning)
# Get your key at: https://aistudio.google.com/
GEMINI_API_KEY=

# Tavily API Key (Required for live web search)
# Get your key at: https://tavily.com/
TAVILY_API_KEY=

# LLM Provider Configuration
# Options: "gemini", "openai", "mock"
LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-1.5-flash

# Maximum Agent Iterations (prevents infinite loops)
MAX_AGENT_ITERATIONS=10

# Database URL (SQLite)
DATABASE_URL=sqlite+aiosqlite:///./agentflow.db

# Server Host & Port
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=5173
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Security & Execution Safety
TOOL_EXECUTION_TIMEOUT_SECONDS=30
REQUIRE_APPROVAL_FOR_SENSITIVE=true

